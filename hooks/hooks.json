{
  "description": "Scope gate, closure gate, write log and failure notice for Appian work.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*__(create|update|add|insert|configure|reorder|upload|replace|delete|remove).*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run_hook.sh\" \"${CLAUDE_PLUGIN_ROOT}\" scope-gate",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*__(create|update|add|insert|configure|reorder|upload|replace|delete|remove).*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run_hook.sh\" \"${CLAUDE_PLUGIN_ROOT}\" log-write",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run_hook.sh\" \"${CLAUDE_PLUGIN_ROOT}\" failure-notice",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run_hook.sh\" \"${CLAUDE_PLUGIN_ROOT}\" closure-gate",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
