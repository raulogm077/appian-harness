{
  "description": "Scope gate, closure gate, write log and failure notice for Appian work.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*__(create|update|add|insert|configure|reorder|upload|replace|delete|remove).*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/harness_hooks.py\" scope-gate",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*__(create|update|add|insert|configure|reorder|upload|replace|delete|remove).*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/harness_hooks.py\" log-write",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/harness_hooks.py\" failure-notice",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/harness_hooks.py\" closure-gate",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
