{
  "description": "Requirements check, scope gate, closure gate, write log, evidence-write log and failure notice for Appian work.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run_hook.sh\" \"${CLAUDE_PLUGIN_ROOT}\" session-start",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__[a-zA-Z0-9_-]*[Aa]ppian[a-zA-Z0-9_-]*__(appian_)?(create|update|add|insert|configure|reorder|upload|replace|delete|remove|invoke|start|execute|run|test).*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run_hook.sh\" \"${CLAUDE_PLUGIN_ROOT}\" scope-gate",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__[a-zA-Z0-9_-]*[Aa]ppian[a-zA-Z0-9_-]*__(appian_)?(create|update|add|insert|configure|reorder|upload|replace|delete|remove|invoke|start|execute|run|test).*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run_hook.sh\" \"${CLAUDE_PLUGIN_ROOT}\" log-write",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run_hook.sh\" \"${CLAUDE_PLUGIN_ROOT}\" log-evidence-write",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "mcp__[a-zA-Z0-9_-]*[Aa]ppian[a-zA-Z0-9_-]*__(appian_)?(create|update|add|insert|configure|reorder|upload|replace|delete|remove|invoke|start|execute|run|test).*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run_hook.sh\" \"${CLAUDE_PLUGIN_ROOT}\" failure-notice",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run_hook.sh\" \"${CLAUDE_PLUGIN_ROOT}\" closure-gate",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
